# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgres://watchdogs:watchdogs@localhost:5432/watchdogs
# Without Docker or a local Postgres, single-process dev can use: pglite://./.pgdata
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# --- Mail ---
# Local dev uses Mailpit (docker compose). Production: Gmail SMTP with an app password.
# smtp (Mailpit / Gmail) or console (prints emails to the terminal)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="watchdogs <alerts@localhost>"

# --- Watcher ---
# mock | bms | ingest
SHOW_SOURCE=mock
POLL_INTERVAL_SECONDS=180
BMS_REGION_DEFAULT=HYD
BROWSER_PROFILE_DIR=./.browser-profile
# Token the collector CLI uses to push snapshots to /api/ingest
INGEST_TOKEN=change-me

# --- Seed ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too
SEED_SAMPLE_MOVIES=true
